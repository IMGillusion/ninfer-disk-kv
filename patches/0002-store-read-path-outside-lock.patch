# DiskKVStore: keep the read path out of the store-wide lock
# Baseline: the author's L3 work tree (proactive-evict), NOT upstream.
# Series context: the full L3 disk tier lives in the ninfer-disk-kv repo;
# these two patches are the reviewable delta measured in
# kvcache_test/L3_STEP1_PIPELINE.md (restore 11-13s -> 4.6s for 93K tokens).
# Changed lines: 59
--- a/src/core/disk_kv_store.cpp
+++ b/src/core/disk_kv_store.cpp
@@ -123,6 +123,7 @@
         if (opts_.max_slots == 0) { throw std::invalid_argument("capacity too small"); }
     }
     max_slots_ = opts_.max_slots;
+    readers_.assign(max_slots_, 0);
     slot_pitch_ = slot_bytes();
     file_bytes_ = trailer_off() + kTrailerSize;
 
@@ -242,6 +243,7 @@
 
