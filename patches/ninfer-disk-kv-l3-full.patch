+                            pages.committed_columns(logical),
+                            static_cast<int>(pages.host_resident(logical)),
+                            static_cast<int>(pages.device_resident(logical)),
+                            static_cast<int>(pages.device_resident(logical) &&
+                                             pages.can_pin_source(logical)),
